# Copie este arquivo para .env.local e preencha só o que você for usar.
# Vazio = desligado. O .env.local nunca vai pro GitHub.

# Agenda (Google Agenda, Outlook, Apple…): o "endereço secreto no formato iCal".
# Dá pra colocar mais de um, separados por espaço.
AGENDA_ICS_URL=

# Linear: Settings → Security & access → Personal API keys
LINEAR_API_KEY=
# opcional: só as issues deste projeto (nome exato)
LINEAR_PROJETO=

# Opcional: resumir pela API do Claude (pago por uso). O normal é usar o agente instalado (veja AGENTE abaixo).
# Chave em console.anthropic.com.
ANTHROPIC_API_KEY=
# opcional: outro modelo do Claude (padrão: claude-opus-5-5)
RESUMO_MODELO=

# Agente padrão do "✨ resumir" (claude, codex, copilot ou cursor). Vazio = o primeiro instalado.
AGENTE=
